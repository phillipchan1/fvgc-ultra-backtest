# Copy this file to .env and fill in the values.
# .env is gitignored — your real keys never leave your machine.
# Tools auto-load .env on startup (no need to source manually).

# Notion Internal Integration secret. Create one at:
#   https://www.notion.so/profile/integrations
# Then share the FVGC Playbook database with the integration:
#   Database in Notion → ⋯ → Connections → invite your integration
NOTION_API_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key. Create one at:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
